###  https://example.org/factorio#iron_gear_wheel
:iron_gear_wheel rdf:type owl:NamedIndividual ,
                          :IntermediateProduct ,
                          :Material ,
                          :ProductionEntity ;
                 :rawMaterial :iron_ore .


###  https://example.org/factorio#iron_gear_wheel_recipe
:iron_gear_wheel_recipe rdf:type owl:NamedIndividual ,
                                 :Recipe ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :produces ;
