                                   owl:onClass :IntermediateProduct
                                 ] ;
                        :hasIngredientUse :ingredient_use_5 ;
                        :produces :iron_gear_wheel ;
                        :yield "1"^^xsd:positiveInteger .


###  https://example.org/factorio#iron_ore
:iron_ore rdf:type owl:NamedIndividual ,
                   :Material ,
                   :ProductionEntity ,
                   :RawResource ,
                   :SolidResource .


###  https://example.org/factorio#iron_plate
:iron_plate rdf:type owl:NamedIndividual ,
                     :IntermediateProduct ,
                     :Material ,
                     :MetalPlate ,
                     :ProductionEntity ;
            :rawMaterial :iron_ore .


